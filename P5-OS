import threading
# Create a lock for proper printing
print_lock = threading.Lock()
# Function to generate Fibonacci sequence
def generate_fibonacci(n):
a, b = 0, 1
sequence = []
for _ in range(n):
sequence.append(a)
a, b = b, a + b
return sequence
# Function to run in each thread
def task(n):
result = generate_fibonacci(n)
with print_lock:
print(f"Fibonacci({n}) = {result}")
# Main program to create threads
if __name__ == "__main__":
print("Multi-threaded Fibonacci Sequence Generator")
print("Name: Trisha")
print("Roll no: S086\n")
# Changed values
values = [7, 8, 10]
threads = []
# Create and start threads
for n in values:
t = threading.Thread(target=task, args=(n,))
threads.append(t)
t.start()
# Wait for all threads to complete
for t in threads:
t.join()
print("\nAll threads completed.")

