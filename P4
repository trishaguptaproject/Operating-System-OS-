# CPU Scheduling Algorithm - Non-Preemptive SJF
# Aim: Simulate Non-Preemptive Shortest Job First Scheduling
# Name: Trisha Gupta
# Roll No: S086

print("==============================================")
print(" NON-PREEMPTIVE SJF CPU SCHEDULING ALGORITHM ")
print("==============================================")
print("Name     : Trisha Gupta")
print("Roll No. : S086")
print("==============================================")


# Process Information
processes = ["P1", "P2", "P3", "P4"]
arrival_time = [0, 2, 4, 5]
burst_time = [7, 4, 1, 4]

n = len(processes)

completed = [False] * n
completion_time = [0] * n
waiting_time = [0] * n
turnaround_time = [0] * n

gantt_process = []

current_time = 0
completed_processes = 0


# Non-Preemptive SJF Scheduling

while completed_processes < n:

    shortest = -1
    minimum_burst = 9999

    for i in range(n):
        if arrival_time[i] <= current_time and completed[i] == False:
            if burst_time[i] < minimum_burst:
                minimum_burst = burst_time[i]
                shortest = i

    if shortest == -1:
        current_time += 1
    else:
        current_time += burst_time[shortest]

        completion_time[shortest] = current_time
        turnaround_time[shortest] = completion_time[shortest] - arrival_time[shortest]
        waiting_time[shortest] = turnaround_time[shortest] - burst_time[shortest]

        completed[shortest] = True
        completed_processes += 1

        gantt_process.append(processes[shortest])


# Display Process Table

print("\nProcess Scheduling Details")
print("------------------------------------------------")
print("Process\tAT\tBT\tCT\tWT\tTAT")
print("------------------------------------------------")

for i in range(n):
    print(processes[i], "\t",
          arrival_time[i], "\t",
          burst_time[i], "\t",
          completion_time[i], "\t",
          waiting_time[i], "\t",
          turnaround_time[i])

print("------------------------------------------------")


# Average Calculation

average_waiting_time = sum(waiting_time) / n
average_turnaround_time = sum(turnaround_time) / n


print("Average Waiting Time =", average_waiting_time, "ms")
print("Average Turnaround Time =", average_turnaround_time, "ms")


# Gantt Chart

print("\n\nGantt Chart (Gap Diagram)")
print()


print("+---------+---------+---------+---------+")

print("|", end="")

for p in gantt_process:
    print("    " + p + "   |", end="")

print()

print("+---------+---------+---------+---------+")


# Time intervals

time = 0
print("0", end="")

for p in gantt_process:
    index = processes.index(p)
    time = completion_time[index]
    print("        " + str(time), end="")


print("\n")


# Execution Order

print("Process Execution Order:")

for i in range(len(gantt_process)):
    if i != len(gantt_process)-1:
        print(gantt_process[i], "-->", end=" ")
    else:
        print(gantt_process[i])


print("\n==============================================")
print("          Program Completed Successfully       ")
print("==============================================")
