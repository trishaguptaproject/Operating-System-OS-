# ROUND ROBIN SCHEDULING
def round_robin(processes, quantum):

    n = len(processes)

    # Remaining burst time
    remaining = [p[2] for p in processes]

    # Completion time
    completion = [0] * n

    # Turnaround time
    turnaround = [0] * n

    # Waiting time
    waiting = [0] * n

    ready_queue = []
    visited = [False] * n

    time = 0
    completed = 0

    # Gantt chart
    gantt = []

    # Start from first arrival time
    time = min(p[1] for p in processes)

    # Add initially arrived processes
    for i in range(n):
        if processes[i][1] <= time:
            ready_queue.append(i)
            visited[i] = True

    # Execute until all processes are completed
    while completed < n:

        # If ready queue is empty
        if not ready_queue:

            next_arrival = min(
                processes[i][1]
                for i in range(n)
                if remaining[i] > 0
            )

            time = next_arrival

            for i in range(n):
                if (processes[i][1] <= time
                        and not visited[i]
                        and remaining[i] > 0):

                    ready_queue.append(i)
                    visited[i] = True

            continue

        # Select first process
        current = ready_queue.pop(0)

        start_time = time

        # Execute for maximum quantum
        execution_time = min(
            quantum,
            remaining[current]
        )

        time = time + execution_time

        remaining[current] = (
            remaining[current] - execution_time
        )

        # Store Gantt chart information
        gantt.append(
            (processes[current][0], start_time, time)
        )

        # Add newly arrived processes
        for i in range(n):

            if (processes[i][1] <= time
                    and not visited[i]
                    and remaining[i] > 0):

                ready_queue.append(i)
                visited[i] = True

        # If process is not completed,
        # add it again to the queue
        if remaining[current] > 0:

            ready_queue.append(current)

        else:

            completion[current] = time
            completed = completed + 1

    # Calculate TAT and WT
    for i in range(n):

        turnaround[i] = (
            completion[i] - processes[i][1]
        )

        waiting[i] = (
            turnaround[i] - processes[i][2]
        )

    return completion, turnaround, waiting, gantt

