TIME_QUANTUM = 2

# ROUND ROBIN SCHEDULING

def round_robin(processes, quantum):
    n = len(processes)

    remaining = [p[2] for p in processes]
    completion = [0] * n
    turnaround = [0] * n
    waiting = [0] * n

    ready_queue = []
    visited = [False] * n

    time = 0
    completed = 0

    gantt = []

    # Start at earliest arrival time
    time = min(p[1] for p in processes)

    # Add processes that have already arrived
    for i in range(n):
        if processes[i][1] <= time and not visited[i]:
            ready_queue.append(i)
            visited[i] = True

    while completed < n:

        # If queue is empty, move time to next arrival
        if not ready_queue:
            next_arrival = min(
                processes[i][1]
                for i in range(n)
                if remaining[i] > 0
            )

            time = max(time, next_arrival)

            for i in range(n):
                if processes[i][1] <= time and not visited[i]:
                    ready_queue.append(i)
                    visited[i] = True

            continue

        current = ready_queue.pop(0)

        start_time = time

        execution_time = min(quantum, remaining[current])

        time += execution_time
        remaining[current] -= execution_time

        gantt.append(
            (processes[current][0], start_time, time)
        )

        # Add newly arrived processes
        for i in range(n):
            if (processes[i][1] <= time
                    and not visited[i]
                    and remaining[i] > 0):
                ready_queue.append(i)
                visited[i] = True

        # If process is not completed, put it back
        if remaining[current] > 0:
            ready_queue.append(current)
        else:
            completion[current] = time
            completed += 1

    # Calculate TAT and WT
    for i in range(n):
        turnaround[i] = completion[i] - processes[i][1]
        waiting[i] = turnaround[i] - processes[i][2]

    return completion, turnaround, waiting, gantt

# FCFS SCHEDULING
def fcfs(processes):
    # Sort processes according to arrival time
    sorted_processes = sorted(processes, key=lambda x: x[1])

    completion = {}
    turnaround = {}
    waiting = {}

    gantt = []
    time = 0

    for name, arrival, burst in sorted_processes:

        # CPU remains idle if process has not arrived
        if time < arrival:
            time = arrival

        start_time = time
        time += burst

        completion[name] = time
        turnaround[name] = completion[name] - arrival
        waiting[name] = turnaround[name] - burst

        gantt.append((name, start_time, time))

    return completion, turnaround, waiting, gantt

# PRINT GANTT CHART
def print_gantt(gantt):
    print("\nGantt Chart:")
    print("-" * 60)

    # Process boxes
    print("|", end="")
    for process, start, end in gantt:
        print(f"  {process:^6} |", end="")
    print()

    print("-" * 60)

    # Time values
    print(gantt[0][1], end="")
    for process, start, end in gantt:
        print(f"{end:>10}", end="")
    print()

