import threading
import time
import random

# Size of the bounded buffer
BUFFER_SIZE = 5

# Circular buffer
buffer = [None] * BUFFER_SIZE

# Index where producer inserts the next item
in_index = 0

# Index where consumer removes the next item
out_index = 0

# Mutex: allows only one thread to access the buffer at a time
mutex = threading.Lock()

# Semaphore for empty spaces
empty = threading.Semaphore(BUFFER_SIZE)

# Semaphore for filled spaces
full = threading.Semaphore(0)


def producer():
    global in_index

    for item in range(1, 11):
        # Wait for an empty space
        empty.acquire()

        # Enter critical section
        mutex.acquire()

        buffer[in_index] = item
        print("Produced:", item, "at position", in_index)

        # Circular queue
        in_index = (in_index + 1) % BUFFER_SIZE

        # Leave critical section
        mutex.release()

        # Increase number of filled spaces
        full.release()

        time.sleep(random.uniform(0.5, 1.5))


def consumer():
    global out_index

    for i in range(1, 11):
        # Wait for an available item
        full.acquire()

        # Enter critical section
        mutex.acquire()

        item = buffer[out_index]
        buffer[out_index] = None

        print("Consumed:", item, "from position", out_index)

        # Circular queue
        out_index = (out_index + 1) % BUFFER_SIZE

        # Leave critical section
        mutex.release()

        # Increase number of empty spaces
        empty.release()

        time.sleep(random.uniform(0.5, 2))


# Create producer and consumer threads
producer_thread = threading.Thread(target=producer)
consumer_thread = threading.Thread(target=consumer)

# Start threads
producer_thread.start()
consumer_thread.start()

# Wait for both threads to finish
producer_thread.join()
consumer_thread.join()

print("\nProducer-Consumer execution completed.")
